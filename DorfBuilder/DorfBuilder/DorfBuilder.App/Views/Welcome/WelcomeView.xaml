<UserControl x:Class="DorfBuilder.App.Views.Welcome.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel MaxWidth="480">
            <TextBlock Text="WPF-Projektvorlage"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="#4B5563"
                       Text="Lege links einen Eintrag an. Der Beispielablauf führt durch ViewModel, CQRS-Handler, Repository und SQLite-Datenbank." />
        </StackPanel>
    </Border>
</UserControl>

