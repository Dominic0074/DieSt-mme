<UserControl x:Class="DorfBuilder.App.Views.SideBar.SideBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:DorfBuilder.App.Views.SideBar.Items">
    <Border Background="#F9FAFB"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Margin="4,4,4,12"
                           Text="DorfBuilder"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <UniformGrid Margin="0,0,0,12"
                             Columns="2">
                    <Button Margin="0,0,4,0"
                            Content="Start"
                            Command="{Binding ShowHomeCommand}" />
                    <Button Margin="4,0,0,0"
                            Content="Info"
                            Command="{Binding ShowInfoCommand}" />
                </UniformGrid>
            </StackPanel>

            <items:ItemsView DataContext="{Binding Items}" />
        </DockPanel>
    </Border>
</UserControl>

