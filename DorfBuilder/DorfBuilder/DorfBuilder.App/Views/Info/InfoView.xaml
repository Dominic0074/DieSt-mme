<UserControl x:Class="DorfBuilder.App.Views.Info.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="28"
            VerticalAlignment="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Architektur"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="App → Application → Domain&#x0a;Infrastructure → Application + Domain&#x0a;&#x0a;Die UI kennt nur Anwendungsfälle und Domain-Modelle. Technische Details bleiben in Infrastructure." />
        </StackPanel>
    </Border>
</UserControl>

